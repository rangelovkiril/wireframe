---
// The logo of the forge a link points to (Codeberg or GitHub), in the official
// light/dark variants; nothing for other links. Decorative: the link text names
// the forge.
interface Props {
  href: string;
}
const host = new URL(Astro.props.href).hostname;
const name = ({ "codeberg.org": "codeberg", "github.com": "github" } as Record<string, string>)[host];
---

{
  name && (
    <picture>
      <source srcset={`/logos/${name}-white.svg`} media="(prefers-color-scheme: dark)" />
      <img class="forge" src={`/logos/${name}.svg`} alt="" width="18" height="18" />
    </picture>
  )
}

<style>
  picture {
    display: flex;
    flex: none;
  }
  .forge {
    flex: none;
    width: 18px;
    height: 18px;
  }
</style>
