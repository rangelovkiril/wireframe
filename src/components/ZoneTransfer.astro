---
import { transfer } from "../data/zone.ts";
---

<section class="transfer" aria-labelledby="transfer-heading">
  <h2 id="transfer-heading">{transfer.title}</h2>
  <p>{transfer.text}</p>
  <pre class="command"><code>{transfer.command}</code></pre>
  <a class="download" href={transfer.file} download>{transfer.download}</a>
</section>

<style>
  .transfer {
    background: var(--panel);
    padding: 24px 20px;
    margin: 48px -20px 0;
  }
  @media (min-width: 720px) {
    .transfer {
      padding: 32px;
      margin-inline: -32px;
    }
  }
  h2 {
    font-size: clamp(24px, 5.5vw, 32px);
    font-weight: 800;
    letter-spacing: -0.015em;
    line-height: 1.15;
    margin: 0 0 8px;
  }
  p {
    color: var(--muted);
    max-width: 60ch;
  }
  .command {
    font-size: clamp(14px, 3.8vw, 17px);
    margin: 0 0 12px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .download {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
  }
</style>
