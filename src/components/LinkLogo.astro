---
// The logo of the site a link points to (Codeberg, GitHub, LinkedIn), in the
// official light/dark variants; nothing for other links. Decorative: the link
// text names the site. Codeberg and GitHub are SVGs in public/logos/; the
// LinkedIn "in" logo is the official PNG in assets/logos/, scaled at build time.
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

interface Props {
  href: string;
}

const sites: Record<string, string> = {
  "codeberg.org": "codeberg",
  "github.com": "github",
  "www.linkedin.com": "linkedin",
  "linkedin.com": "linkedin",
};
const name = sites[new URL(Astro.props.href).hostname];

const rasters = import.meta.glob<{ default: ImageMetadata }>("../assets/logos/linkedin*.png", { eager: true });
const raster = async (file: string) => {
  const img = rasters[`../assets/logos/${file}`]?.default;
  if (!img) throw new Error(`${file} not found in assets/logos/`);
  // 21px: LinkedIn's minimum size on screen
  const out = await getImage({ src: img, height: 21, densities: [1, 2, 3], format: "webp" });
  return { src: out.src, srcset: out.srcSet.attribute };
};

let light: { src: string; srcset?: string } | undefined;
let dark: { src: string; srcset?: string } | undefined;
if (name === "linkedin") {
  light = await raster("linkedin.png");
  dark = await raster("linkedin-white.png");
} else if (name) {
  light = { src: `/logos/${name}.svg` };
  dark = { src: `/logos/${name}-white.svg` };
}
---

{
  light && (
    <picture>
      {dark && <source srcset={dark.srcset ?? dark.src} media="(prefers-color-scheme: dark)" />}
      <img class="site-logo" src={light.src} srcset={light.srcset} alt="" height="21" />
    </picture>
  )
}

<style>
  /* same box for every logo (the LinkedIn one is wider, with its ®), so the link texts line up */
  picture {
    display: flex;
    flex: none;
    width: 25px;
  }
  .site-logo {
    height: 21px;
    width: auto;
  }
</style>
