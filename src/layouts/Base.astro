---
import { Font } from "astro:assets";
import "../styles/global.css";
import { profile } from "../data/zone.ts";

interface Props {
  title?: string;
}
const title = Astro.props.title ?? profile.name;
const image = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={profile.tagline} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={profile.tagline} />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font-hanken" preload />
    <Font cssVariable="--font-sometype" preload />
  </head>
  <body>
    <slot />
  </body>
</html>
