---
import Base from "../layouts/Base.astro";
import { notFound } from "../data/zone.ts";
---

<Base title={notFound.title}>
  <main class="page nx">
    <pre>{notFound.header}</pre>
    <h1>{notFound.text}</h1>
    <a href="/">{notFound.back}</a>
  </main>
</Base>

<style>
  .nx {
    padding-block: clamp(64px, 16vw, 140px);
  }
  pre {
    margin: 0 0 24px;
    font-size: clamp(13px, 3.6vw, 18px);
    color: var(--t-SOA);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  h1 {
    margin: 0 0 24px;
    font-size: clamp(32px, 8vw, 56px);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.03em;
    max-width: 16ch;
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
  }
</style>
