---
import { Font } from "astro:assets";
import "../styles/global.css";
import Hero from "../components/Hero.astro";
import Guide from "../components/Guide.astro";
import Record from "../components/Record.astro";
import ZoneTransfer from "../components/ZoneTransfer.astro";
import { footer, profile } from "../data/zone.ts";
import { liveSections } from "../lib/live.ts";
import { dnskeyRandomart } from "../lib/randomart.ts";

const sections = await liveSections();
const dnskey = sections.flatMap((s) => s.records).find((r) => r.rdata.type === "DNSKEY")?.rdata;
const randomart = dnskey?.type === "DNSKEY" ? await dnskeyRandomart(dnskey.key) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.name}</title>
    <meta name="description" content={profile.tagline} />
    <link rel="canonical" href={Astro.site} />
    <Font cssVariable="--font-hanken" preload />
    <Font cssVariable="--font-sometype" preload />
  </head>
  <body>
    <div class="page">
      <Hero />
      <main>
        <Guide />
        <section class="records" aria-label="Records of rangelov.dev">
          {sections.map((section) => (
            <Record section={section} open={section.group === "soa"} randomart={randomart} />
          ))}
        </section>
        <ZoneTransfer />
      </main>
      <footer class="footer">
        <p>{footer.built}</p>
        <a href={footer.dnssec.href}>
          <span class="desec" aria-hidden="true"></span>
          {footer.dnssec.label}
        </a>
      </footer>
    </div>
  </body>
</html>

<style>
  .records {
    border-bottom: 1px solid var(--line);
  }
  /* deSEC's own umbrella mark (MIT, see public/logos/desec.svg), in the text colour */
  .desec {
    width: 18px;
    height: 20px;
    background: currentColor;
    mask: url("/logos/desec.svg") center / contain no-repeat;
  }
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 24px;
    padding-block: 32px 48px;
    color: var(--muted);
    font-size: 15px;
  }
  .footer p {
    margin: 0;
  }
  .footer a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    color: var(--muted);
  }
</style>
